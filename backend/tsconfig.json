{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "load-env.ts",
    "db.ts",
    "session.ts",
    "mail/**/*.ts",
    "totp/**/*.ts",
    "verification/**/*.ts",
    "password-reset/**/*.ts",
    "middleware/**/*.ts",
    "routes/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
