PORT=4000
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/leave_request_system
JWT_SECRET=

# Local development uses Mailpit (SMTP 1025, UI http://localhost:8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Leave Request System <noreply@leave.local>
# SMTP_USER=
# SMTP_PASS=

# For a controlled Mailgun sandbox demo, replace the values above with the
# sandbox SMTP settings shown in Mailgun. Commonly port 587 uses STARTTLS,
# so SMTP_SECURE=false; use the host and port for your Mailgun region.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# MAIL_FROM=
# SMTP_USER=
# SMTP_PASS=

# Frontend origin used in verification, password-reset, and authenticator-reset email links.
APP_ORIGIN=http://localhost:5173

# Optional. Encrypts authenticator secrets at rest. Falls back to JWT_SECRET.
# TOTP_ENCRYPTION_KEY=
